{
  "name": "fabric.pub",
  "version": "0.1.0",
  "description": "public endpoints for Fabric resources",
  "main": "scripts/http.js",
  "dependencies": {
    "@fabric/core": "FabricLabs/fabric#feature/passport",
    "@fabric/http": "FabricLabs/fabric-http#feature/passport"
  },
  "devDependencies": {
    "http-server": "=14.1.1",
    "mocha": "=12.0.3"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "report:install": "rm -rf node_modules && mkdir -p reports && rm -f package-lock.json && echo \"$ npm i --allow-git=all\" > reports/install.log && npm i --allow-git=all >> reports/install.log 2>&1",
    "start": "fabric-http assets",
    "test": "mocha tests"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/FabricLabs/fabric.pub.git"
  },
  "keywords": [
    "fabric",
    "bitcoin",
    "http",
    "web",
    "lightning",
    "rootstock"
  ],
  "engines": {
    "node": "26.12.1",
    "npm": ">=12.0.0"
  },
  "author": "Fabric Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FabricLabs/fabric.pub/issues"
  },
  "homepage": "https://github.com/FabricLabs/fabric.pub#readme",
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "=14.0.3",
    "minimatch@>=9.0.0 <11.0.1": "=11.0.3",
    "page": {
      "path-to-regexp": "=1.9.0"
    }
  }
}
